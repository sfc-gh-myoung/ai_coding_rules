# ============================================================================
# AI Coding Rules — Makefile
# Development automation. Docs: docs/USING_DEV_CLI.md, conventions: AGENTS.md
# Supported platforms: macOS (darwin), Linux. Works with GNU Make 3.81+.
#
# `make help` is generated by awk from the annotations in this file:
#   ## @section Name | note      starts a help section (dim note optional)
#   ## @quickstart cmd | text    a Quickstart row
#   ## @example cmd | text       a closing example
#   ## @override VAR=value | text  a variable override
#   ## @inputs VAR=x [OPT=y]     inputs of the next target
#   ## @needs tools or cost      prerequisites of the next target
#   target: ## description       lists a target; targets without `##` fail
#                                `make quality-makefile`
# ============================================================================

# Resolved before any include so make -C and make -f work from any directory.
# The shell resolves the path so directories with spaces survive.
MAKEFILE_SOURCE := $(strip $(MAKEFILE_LIST))
ROOT_DIR := $(shell cd "$$(dirname '$(MAKEFILE_SOURCE)')" && pwd -P)
MAKEFILE_PATH := $(ROOT_DIR)/$(shell basename '$(MAKEFILE_SOURCE)')

SHELL := /bin/bash
# GNU Make 3.81 ignores .SHELLFLAGS; multi-step recipes also start with `set -eu`.
.SHELLFLAGS := -eu -o pipefail -c
.DEFAULT_GOAL := help
.SUFFIXES:
.DELETE_ON_ERROR:

# Overridable on the command line or from the environment.
UV ?= uv
UV_PYTHON ?= 3.12
PYTHON_VERSION ?= $(UV_PYTHON)
FORCE ?= 0
DRY_RUN ?= 0
CLI_ARGS ?=
V ?=
VERBOSE ?=
VERSION ?=
CONFIRM ?=
BUNDLE ?=
REPORT ?=
ADMIN_CONNECTION ?=
ADMIN_ROLE ?=

export PYTHONDONTWRITEBYTECODE := 1

# Single-quote a value for the shell: $(call shq,value)
shq = '$(subst ','"'"',$(1))'

# Colors follow one rule: on when fd $(1) is a TTY and TERM is not dumb, or when
# FORCE_COLOR/CLICOLOR_FORCE is set; always off when NO_COLOR is set.
COLOR_TEST = [ -z "$${NO_COLOR:-}" ] && { { [ -t $(1) ] && [ "$${TERM:-}" != dumb ]; } || [ "$${FORCE_COLOR:-0}" != 0 ] || [ "$${CLICOLOR_FORCE:-0}" != 0 ]; }
# Shell-time palette in $B bold, $D dim, $R red, $G green, $Y yellow, $C cyan, $N reset.
colors = if $(call COLOR_TEST,$(1)); then B=$$(printf '\033[1m'); D=$$(printf '\033[2m'); R=$$(printf '\033[31m'); G=$$(printf '\033[32m'); Y=$$(printf '\033[33m'); C=$$(printf '\033[36m'); N=$$(printf '\033[0m'); else B=; D=; R=; G=; Y=; C=; N=; fi
# Recipe messages: $(call say,text,G|D|Y) prints; $(call fail,text) prints in red to stderr and exits 1.
say = $(call colors,1); printf '%s%s%s\n' "$$$(2)" $(call shq,$(1)) "$$N"
fail = { $(call colors,2); printf '%s%s%s\n' "$$R" $(call shq,$(1)) "$$N" >&2; exit 1; }
# Stop with an install message when a tool is missing: $(call need,tool,message)
need = command -v $(1) >/dev/null 2>&1 || $(call fail,$(2))
# Parse-time stderr color for $(error) messages.
ERR_COLOR := $(shell $(call COLOR_TEST,2) && echo 1)
ERR_ESC := $(if $(ERR_COLOR),$(shell printf '\033'))
ERR_RED := $(if $(ERR_COLOR),$(ERR_ESC)[31m)
ERR_RST := $(if $(ERR_COLOR),$(ERR_ESC)[0m)
# Stop with a usage message when a variable is empty: $(call require,VAR,usage)
require = $(if $(strip $($(1))),,$(error $(ERR_RED)$(1) is required. Usage: $(2)$(ERR_RST)))

# Recipes do not echo commands by default; `make V=1 <target>` (or VERBOSE=1) shows them.
ifeq ($(strip $(V)$(VERBOSE)),)
.SILENT:
endif

UV_Q = $(call shq,$(UV))
PY_Q = $(call shq,$(PYTHON_VERSION))
UV_RUN = $(UV_Q) run --locked --python $(PY_Q)
UNAME := $(shell uname)
# Composite targets call $(MAKE) $(SUBMAKE) once per step so steps run in order,
# even under -j, and make -n prints every step without running it.
SUBMAKE = -C $(call shq,$(ROOT_DIR)) -f $(call shq,$(MAKEFILE_PATH))
MAKEFLAGS += --no-print-directory --no-builtin-rules --warn-undefined-variables

MARKDOWN_RULES_TARGETS := rules/
MARKDOWN_DOCS_TARGETS := docs/ README.md CONTRIBUTING.md CHANGELOG.md AGENTS.md
SHELL_SCRIPTS := scripts/maintainer-common.sh scripts/release.sh scripts/clean.sh scripts/plugin-verify.sh

## @quickstart make env-setup | Pin Python and create .venv (needs uv)
## @quickstart make env-sync | Install locked development dependencies
## @quickstart make quality-all-fix | Fix, then check Python, Markdown, and automation
## @quickstart make validate | Run every gate before opening a PR
## @override UV=/path/to/uv | Use a specific uv executable
## @override PYTHON_VERSION=3.13 | Run targets with another interpreter (default 3.12)
## @override V=1 | Echo every recipe command (VERBOSE=1 works too)
## @override NO_COLOR=1 | Disable color; piped output is never colored
## @override FORCE_COLOR=1 | Keep color when piped (CLICOLOR_FORCE=1 works too)
## @example make test-run CLI_ARGS="-k name -x" | Pass extra arguments to pytest
## @example make release-bump VERSION=X.Y.Z DRY_RUN=1 | Preview a release without writes
## @example make -C /path/to/repo validate | Run from another directory

# Help text is parsed from this file's own annotations; see the header.
define HELP_AWK
function pad(s, n) { while (length(s) < n) s = s " "; return s }
/^## @[a-z]+ / {
  tag = $$2
  sub(/^## @[a-z]+ +/, "")
  split($$0, a, " [|] ")
  if (tag == "@section") { ns++; sname[ns] = a[1]; snote[ns] = a[2]; cur = ns }
  else if (tag == "@quickstart") { nq++; qa[nq] = a[1]; qb[nq] = a[2]; if (length(a[1]) > qw) qw = length(a[1]) }
  else if (tag == "@example") { ne++; ea[ne] = a[1]; eb[ne] = a[2]; if (length(a[1]) > ew) ew = length(a[1]) }
  else if (tag == "@override") { no++; oa[no] = a[1]; ob[no] = a[2]; if (length(a[1]) > ow) ow = length(a[1]) }
  else if (tag == "@inputs") inp = a[1]
  else if (tag == "@needs") need = a[1]
  next
}
{
  i = index($$0, " ## ")
  if (i == 0) next
  pre = substr($$0, 1, i - 1)
  if (pre !~ /^[A-Za-z0-9_-]+:/ || pre ~ /^[A-Za-z0-9_-]+:=/) next
  name = pre; sub(/:.*/, "", name)
  nt++; tsec[nt] = cur; tname[nt] = name; tdesc[nt] = substr($$0, i + 4); tin[nt] = inp; tneed[nt] = need
  inp = ""; need = ""
  if (length(name) > tw) tw = length(name)
}
END {
  printf "%s%s%s %s (%s)\n", b, proj, n, ver, sha
  printf "%sUsage:%s make %s<target>%s %s[VAR=value ...]%s   (bare make runs help)\n\n", b, n, c, n, y, n
  if (nq) {
    printf "%sQuickstart%s\n", b, n
    for (k = 1; k <= nq; k++) printf "  %s%s%s  %s\n", c, pad(qa[k], qw), n, qb[k]
    printf "\n"
  }
  for (s = 1; s <= ns; s++) {
    printf "%s%s%s\n", b, sname[s], n
    if (snote[s] != "") printf "  %s%s%s\n", d, snote[s], n
    for (k = 1; k <= nt; k++) if (tsec[k] == s) {
      printf "  %s%s%s  %s\n", c, pad(tname[k], tw), n, tdesc[k]
      if (tin[k] != "") printf "  %s  %sinputs:%s %s%s%s\n", pad("", tw), d, n, y, tin[k], n
      if (tneed[k] != "") printf "  %s  %sneeds:%s  %s\n", pad("", tw), d, n, tneed[k]
    }
    printf "\n"
  }
  if (no) {
    printf "%sOverrides%s\n", b, n
    for (k = 1; k <= no; k++) printf "  %s%s%s  %s\n", y, pad(oa[k], ow), n, ob[k]
    printf "\n"
  }
  if (ne) {
    printf "%sExamples%s\n", b, n
    for (k = 1; k <= ne; k++) printf "  %s%s%s  %s%s%s\n", c, pad(ea[k], ew), n, d, eb[k], n
  }
}
endef
export HELP_AWK

# Drift check: every target needs a `##` description and a .PHONY entry.
define CHECK_AWK
/^[.]PHONY:/ { for (i = 2; i <= NF; i++) phony[$$i] = 1; next }
/^[A-Za-z0-9_-]+:([^=]|$$)/ {
  name = $$0; sub(/:.*/, "", name)
  if (!(name in seen)) { seen[name] = 1; order[++count] = name }
  if (index($$0, " ## ")) described[name] = 1
}
END {
  for (k = 1; k <= count; k++) {
    t = order[k]
    if (!(t in described)) { print "No ## description: " t; bad = 1 }
    if (!(t in phony)) { print "Missing from .PHONY: " t; bad = 1 }
  }
  exit bad
}
endef
export CHECK_AWK

## @section Environment | Needs uv (https://docs.astral.sh/uv/). help and doctor work without it.
.PHONY: help doctor check-uv env-setup env-sync env-lock
help: ## Show this help; needs no uv or synced environment
	@$(call colors,1); set -eu; \
	ver=$$(sed -n '/^version *=/{s/.*"\(.*\)".*/\1/p;q;}' $(call shq,$(ROOT_DIR))/pyproject.toml 2>/dev/null || true); \
	sha=$$(git -C $(call shq,$(ROOT_DIR)) rev-parse --short HEAD 2>/dev/null || echo unknown); \
	awk -v b="$$B" -v d="$$D" -v y="$$Y" -v c="$$C" -v n="$$N" -v proj='AI Coding Rules' -v ver="$${ver:-unknown}" -v sha="$$sha" "$$HELP_AWK" $(call shq,$(MAKEFILE_PATH))

doctor: ## Check tool availability and versions; fails when a required tool is missing
	@$(call colors,1); set -eu; fail=0; \
	probe() { label=$$1; cmd=$$2; need=$$3; \
	  if command -v "$$cmd" >/dev/null 2>&1; then \
	    ver=$$("$$cmd" --version 2>&1 | grep -m1 -E '[0-9]+[.][0-9]+' || true); \
	    printf '  %s%-12s%s %sok%s       %s\n' "$$C" "$$label" "$$N" "$$G" "$$N" "$$ver"; \
	  elif [ "$$need" = required ]; then \
	    printf '  %s%-12s%s %smissing%s  required\n' "$$C" "$$label" "$$N" "$$R" "$$N"; fail=1; \
	  else \
	    printf '  %s%-12s%s %smissing%s  optional\n' "$$C" "$$label" "$$N" "$$Y" "$$N"; \
	  fi; }; \
	printf '%sTools%s\n' "$$B" "$$N"; \
	probe uv $(UV_Q) required; \
	if command -v $(UV_Q) >/dev/null 2>&1; then \
	  py=$$($(UV_Q) python find $(PY_Q) 2>/dev/null || true); \
	  if [ -n "$$py" ]; then printf '  %s%-12s%s %sok%s       %s\n' "$$C" "python $(PYTHON_VERSION)" "$$N" "$$G" "$$N" "$$py"; \
	  else printf '  %s%-12s%s %smissing%s  run make env-setup\n' "$$C" "python $(PYTHON_VERSION)" "$$N" "$$Y" "$$N"; fi; \
	fi; \
	probe shellcheck shellcheck required; \
	probe shfmt shfmt required; \
	probe snow snow optional; \
	probe cortex cortex optional; \
	[ "$$fail" = 0 ] || $(call fail,Install the required tools listed above.)

# Preflight shared by every target that runs uv.
check-uv: ## Check that uv is installed
	@command -v $(UV_Q) >/dev/null 2>&1 || $(call fail,uv not found. Install from https://docs.astral.sh/uv/ or set UV to its executable path.)

## @inputs [PYTHON_VERSION=3.12]
env-setup: check-uv ## Pin Python and create .venv
	$(UV_Q) python install $(PY_Q)
	$(UV_Q) python pin $(PY_Q)
	$(UV_Q) venv --python $(PY_Q)

env-sync: check-uv ## Sync locked development dependencies
	$(UV_Q) sync --locked --python $(PY_Q)

env-lock: check-uv ## Update lockfile and sync development dependencies
	$(UV_Q) lock
	@$(MAKE) $(SUBMAKE) env-sync

## @section Quality | Read-only unless the target ends in -fix.
.PHONY: quality-all quality-all-fix quality-lint quality-lint-fix quality-format quality-format-fix
.PHONY: quality-typecheck quality-markdown quality-markdown-fix quality-automation quality-makefile
quality-all: ## Run Python, Markdown, and automation checks
	@$(MAKE) $(SUBMAKE) quality-lint
	@$(MAKE) $(SUBMAKE) quality-format
	@$(MAKE) $(SUBMAKE) quality-typecheck
	@$(MAKE) $(SUBMAKE) quality-markdown
	@$(MAKE) $(SUBMAKE) quality-automation

quality-all-fix: ## Apply Python and Markdown fixes, then check all quality gates
	@$(MAKE) $(SUBMAKE) quality-lint-fix
	@$(MAKE) $(SUBMAKE) quality-format-fix
	@$(MAKE) $(SUBMAKE) quality-markdown-fix
	@$(MAKE) $(SUBMAKE) quality-all

quality-lint: check-uv ## Run Ruff linter without fixes
	$(UV_RUN) ruff check .

quality-lint-fix: check-uv ## Apply Ruff lint fixes
	$(UV_RUN) ruff check --fix .

quality-format: check-uv ## Check Python formatting
	$(UV_RUN) ruff format --check .

quality-format-fix: check-uv ## Apply Python formatting
	$(UV_RUN) ruff format .

quality-typecheck: check-uv ## Run ty type checker
	$(UV_RUN) ty check .

quality-markdown: check-uv ## Check rules and documentation Markdown
	$(UV_RUN) pymarkdownlnt --config pymarkdown.rules.json scan $(MARKDOWN_RULES_TARGETS)
	$(UV_RUN) pymarkdownlnt --config pymarkdown.docs.json scan $(MARKDOWN_DOCS_TARGETS)

quality-markdown-fix: check-uv ## Fix rules and documentation Markdown
	$(UV_RUN) pymarkdownlnt --config pymarkdown.rules.json fix $(MARKDOWN_RULES_TARGETS)
	$(UV_RUN) pymarkdownlnt --config pymarkdown.docs.json fix $(MARKDOWN_DOCS_TARGETS)

quality-makefile: ## Fail when a target lacks a ## description or a .PHONY entry
	@awk "$$CHECK_AWK" $(call shq,$(MAKEFILE_PATH))

## @needs shellcheck, shfmt
quality-automation: check-uv ## Validate the Makefile, shell syntax, lint, and formatting
	@$(call need,shellcheck,Install ShellCheck to validate automation scripts.)
	@$(call need,shfmt,Install shfmt to check shell formatting.)
	@$(MAKE) $(SUBMAKE) quality-makefile
	@$(MAKE) $(SUBMAKE) -n help >/dev/null
	shellcheck -x -P scripts $(SHELL_SCRIPTS)
	shfmt -d -i 2 -ci $(SHELL_SCRIPTS)

## @section Testing | pytest suites; coverage enforces the configured threshold.
.PHONY: test-run test-automation test-coverage test-coverage-open test-report-browser
## @inputs [CLI_ARGS="-k name -x"]
test-run: check-uv ## Run pytest tests
	$(UV_RUN) pytest tests/ --tb=short $(CLI_ARGS)

test-automation: check-uv ## Test automation using disposable repositories and command stubs
	$(UV_RUN) pytest tests/automation/ tests/test_version_consistency.py --tb=short

test-coverage: check-uv ## Run tests and enforce coverage threshold
	$(UV_RUN) pytest --cov=src/ai_rules --cov-report=term-missing --cov-report=html tests/

## @needs macOS (`open`)
test-coverage-open: ## Run coverage and open HTML report on macOS
ifeq ($(UNAME),Darwin)
	@$(MAKE) $(SUBMAKE) test-coverage
	open htmlcov/index.html
else
	@echo 'test-coverage-open runs on macOS only; skipping.'
endif

## @needs Playwright Chromium download (network)
test-report-browser: check-uv ## Run pinned offline browser report acceptance tests
	$(UV_RUN) --group test-browser python -m playwright install chromium
	$(UV_RUN) --group test-browser pytest tests/report_browser/ -m browser -q --tb=short

## @section Validation | The full gate to run before opening a PR.
.PHONY: validate ci validate-schemas validate-rule-loader
# Runs every gate in order for one interpreter. Hosted CI also tests Python
# 3.13 and automation on macOS and Linux. Cortex loader validation is optional;
# use plugin-verify-strict when Cortex must be present.
## @needs shellcheck, shfmt
validate: ## Full validation including coverage and rule-loader contracts
	@$(MAKE) $(SUBMAKE) status-preflight
	@$(MAKE) $(SUBMAKE) quality-all
	@$(MAKE) $(SUBMAKE) test-coverage
	@$(MAKE) $(SUBMAKE) validate-schemas
	@$(MAKE) $(SUBMAKE) validate-rule-loader
	@$(MAKE) $(SUBMAKE) plugin-verify

ci: validate ## Alias for validate

validate-schemas: check-uv ## Validate rule, example, template, and skill schemas
	$(UV_RUN) ai-rules validate rules/
	$(UV_RUN) ai-rules validate rules/examples/ --examples
	$(UV_RUN) ai-rules validate templates/ --templates
	$(UV_RUN) ai-rules validate-skills skills/

validate-rule-loader: check-uv ## Validate fixtures, corpus reachability, and trigger-count contract
	$(UV_RUN) ai-rules rule-loader validate
	$(UV_RUN) ai-rules rule-loader audit --fail-on-miss
	$(UV_RUN) ai-rules rule-loader validate-trigger-contract

## @section Status | Read-only project state.
.PHONY: status status-preflight
status: check-uv ## Show project counts and the selected interpreter
	@UV=$(UV_Q) $(UV_RUN) python scripts/dev_info.py status

status-preflight: check-uv ## Check uv availability and lockfile consistency
	@test -f pyproject.toml && test -f uv.lock || $(call fail,pyproject.toml and uv.lock must exist in the project root.)
	$(UV_Q) lock --check
	@$(call say,uv is available and the project lockfile is consistent.,G)

## @section Cleanup | Deletes local files; venv removal prompts on a terminal.
.PHONY: clean-cache clean-venv clean-all
clean-cache: ## Remove project caches and coverage output, excluding virtual environments
	bash scripts/clean.sh cache

## @inputs [FORCE=1]
clean-venv: ## Remove .venv; prompts on a terminal
	FORCE=$(call shq,$(FORCE)) bash scripts/clean.sh venv

## @inputs [FORCE=1]
clean-all: ## Confirm once, then remove caches and .venv
	FORCE=$(call shq,$(FORCE)) bash scripts/clean.sh all

## @section Plugin | Plugin fidelity checks; the Cortex CLI is optional except for -strict.
.PHONY: plugin-verify plugin-verify-strict
plugin-verify: check-uv ## Check plugin fidelity; check Cortex loader when installed
	UV=$(UV_Q) UV_PYTHON=$(PY_Q) bash scripts/plugin-verify.sh optional

## @needs cortex CLI
plugin-verify-strict: check-uv ## Check plugin fidelity and require Cortex loader validation
	@$(call need,cortex,Cortex CLI is required. Install it or use plugin-verify for optional loader validation.)
	UV=$(UV_Q) UV_PYTHON=$(PY_Q) bash scripts/plugin-verify.sh required

## @section Evaluation | SQL is generated for administrator review; live runs need a PAT connection and cost AI credits.
.PHONY: eval eval-network-policy eval-setup eval-identity eval-verify eval-pat-create eval-pat-rotate eval-pat-revoke eval-teardown eval-setup-apply eval-connection-add eval-check eval-smoke eval-run eval-all-models eval-report eval-report-verify
# Evaluation defaults. Precedence: `make VAR=x` > environment (`VAR=x make`) > setup/eval.local.mk > these.
EVAL_LOCAL ?= setup/eval.local.mk
-include $(EVAL_LOCAL)
EVAL_USER ?= AI_RULES_EVAL_USER
EVAL_ROLE ?= AI_RULES_EVAL_ROLE
EVAL_PAT ?= AI_RULES_EVAL_PAT
EVAL_CONNECTION ?= ai_rules_eval
EVAL_AUTHENTICATOR ?= PROGRAMMATIC_ACCESS_TOKEN
# Required for SQL generation (no default): ORGANIZATION-ACCOUNT or account locator; not a connection name.
EVAL_ACCOUNT ?=
# Account written to the connection; defaults to EVAL_ACCOUNT (set to e.g. a locator if your environment requires it).
EVAL_CONNECTION_ACCOUNT ?= $(EVAL_ACCOUNT)
# Required for identity and PAT bundles (no default): an approved network policy name.
EVAL_NETWORK_POLICY ?=
EVAL_NETWORK_RULE ?=
EVAL_ALLOWED_NETWORKS ?=
EVAL_OUTPUT_DIR ?= setup/sql
EVAL_DAYS ?= 15
EVAL_OVERLAP_HOURS ?= 24
EVAL_MODEL ?= auto
EVAL_FIXTURE ?= simple-python-task
EVAL_RUNS ?= 1
EVAL_MAX_TURNS ?= 5
EVAL_EFFORT ?= low
# Per-invocation inputs without defaults: BUNDLE, ADMIN_CONNECTION, ADMIN_ROLE, PHASE (all|identity), CONFIRM=1.
PHASE ?= all
EVAL_BUNDLE_FILES = $(sort $(wildcard $(BUNDLE)/*.sql))
EVAL_APPLY_FILES = $(if $(filter identity,$(PHASE)),$(filter-out %-create-pat.sql,$(EVAL_BUNDLE_FILES)),$(EVAL_BUNDLE_FILES))
eval-opt = --$(2) $(call shq,$($(1)))
# SQL bundle generation (the only logic that needs Python).
EVAL_OPTIONS = $(call eval-opt,EVAL_USER,user) $(call eval-opt,EVAL_ROLE,role) $(call eval-opt,EVAL_PAT,token) $(call eval-opt,EVAL_ACCOUNT,account) $(call eval-opt,EVAL_NETWORK_POLICY,network-policy) $(call eval-opt,EVAL_NETWORK_RULE,network-rule) $(call eval-opt,EVAL_ALLOWED_NETWORKS,allowed-networks) $(call eval-opt,EVAL_OUTPUT_DIR,output-dir) $(call eval-opt,EVAL_DAYS,days) $(call eval-opt,EVAL_OVERLAP_HOURS,overlap) $(if $(filter 1,$(CONFIRM)),--confirm)
EVAL_WORKFLOW = $(UV_RUN) ai-rules rule-loader workflow
# Existing rule-loader commands, pinned to PAT connections.
EVAL_RUN_OPTIONS = --require-pat --connection $(call shq,$(EVAL_CONNECTION)) --model $(call shq,$(EVAL_MODEL)) --runs $(call shq,$(EVAL_RUNS)) --max-turns $(call shq,$(EVAL_MAX_TURNS)) --effort $(call shq,$(EVAL_EFFORT)) --concurrency 1

eval: check-uv ## Run informational reviewer eval tests
	$(UV_RUN) pytest tests/reviewer_eval/ -q --tb=short

## @inputs EVAL_NETWORK_POLICY=name EVAL_NETWORK_RULE=name EVAL_ALLOWED_NETWORKS=cidr,...
eval-network-policy: check-uv ## Generate explicit ingress policy SQL
	$(EVAL_WORKFLOW) network-policy $(EVAL_OPTIONS)

## @inputs EVAL_ACCOUNT=ORG-ACCOUNT|locator EVAL_NETWORK_POLICY=name
eval-setup: check-uv ## Generate reviewed identity/verification/PAT bundle
	$(EVAL_WORKFLOW) setup $(EVAL_OPTIONS)

eval-identity: check-uv ## Generate identity SQL only
	$(EVAL_WORKFLOW) identity $(EVAL_OPTIONS)

eval-verify: check-uv ## Generate read-only verification SQL
	$(EVAL_WORKFLOW) verify $(EVAL_OPTIONS)

eval-pat-create: check-uv ## Generate initial PAT issuance SQL
	$(EVAL_WORKFLOW) create-pat $(EVAL_OPTIONS)

## @inputs [EVAL_OVERLAP_HOURS=24]
eval-pat-rotate: check-uv ## Generate rotation SQL
	$(EVAL_WORKFLOW) rotate-pat $(EVAL_OPTIONS)

## @inputs CONFIRM=1
eval-pat-revoke: check-uv ## Generate revocation SQL
	$(EVAL_WORKFLOW) revoke-pat $(EVAL_OPTIONS)

## @inputs CONFIRM=1
eval-teardown: check-uv ## Generate identity teardown SQL
	$(EVAL_WORKFLOW) teardown $(EVAL_OPTIONS)

## @inputs BUNDLE=path ADMIN_CONNECTION=name ADMIN_ROLE=role [PHASE=identity] [CONFIRM=1]
## @needs snow CLI, admin connection; runs SQL as the admin role (PHASE=identity skips PAT issuance)
eval-setup-apply: check-uv ## Run a reviewed bundle with snow sql
	$(call require,BUNDLE,make eval-setup-apply BUNDLE=path ADMIN_CONNECTION=name ADMIN_ROLE=role)
	$(call require,ADMIN_CONNECTION,make eval-setup-apply BUNDLE=path ADMIN_CONNECTION=name ADMIN_ROLE=role)
	$(call require,ADMIN_ROLE,make eval-setup-apply BUNDLE=path ADMIN_CONNECTION=name ADMIN_ROLE=role)
	$(EVAL_WORKFLOW) check-bundle --bundle $(call shq,$(BUNDLE))
	[ "$(CONFIRM)" = 1 ] || { printf 'Run %s as %s/%s? [y/N] ' $(call shq,$(BUNDLE)) $(call shq,$(ADMIN_CONNECTION)) $(call shq,$(ADMIN_ROLE)); read answer; [ "$$answer" = y ] || $(call fail,Aborted.); }
	snow sql --connection $(call shq,$(ADMIN_CONNECTION)) --role $(call shq,$(ADMIN_ROLE)) $(foreach f,$(EVAL_APPLY_FILES),--filename $(call shq,$(f)))

## @inputs EVAL_ACCOUNT=org-account [EVAL_CONNECTION_ACCOUNT=...]
## @needs snow CLI; registers the connection without a credential
eval-connection-add: ## Register a credential-free connection via snow
	$(call require,EVAL_CONNECTION_ACCOUNT,make eval-connection-add EVAL_ACCOUNT=org-account)
	snow connection add --no-interactive --connection-name $(call shq,$(EVAL_CONNECTION)) --account $(call shq,$(EVAL_CONNECTION_ACCOUNT)) --user $(call shq,$(EVAL_USER)) --role $(call shq,$(EVAL_ROLE)) --authenticator $(call shq,$(EVAL_AUTHENTICATOR))
	@echo "Registered without a credential. Supply the PAT via SNOWFLAKE_CONNECTIONS_$(shell echo $(EVAL_CONNECTION) | tr a-z- A-Z_)_PASSWORD or your approved provider."

## @needs PAT connection; the credential format is not validated
eval-check: check-uv ## Check CLI and credential source without a model call
	$(UV_RUN) ai-rules rule-loader doctor --require-pat --connection $(call shq,$(EVAL_CONNECTION))

## @needs PAT connection; costs AI credits
eval-smoke: check-uv ## Run direct CLI smoke
	$(UV_RUN) ai-rules rule-loader doctor --require-pat --with-smoke --connection $(call shq,$(EVAL_CONNECTION))

## @inputs [EVAL_MODEL=auto] [EVAL_FIXTURE=simple-python-task] [EVAL_RUNS=1]
## @needs PAT connection, cortex CLI; costs AI credits
eval-run: check-uv ## Run one fixture through CoCo CLI
	$(UV_RUN) ai-rules rule-loader eval $(EVAL_RUN_OPTIONS) --fixture $(call shq,$(EVAL_FIXTURE))

## @needs PAT connection, cortex CLI; costs AI credits for every fixture and model
eval-all-models: check-uv ## Evaluate all fixtures on all catalog models
	$(UV_RUN) ai-rules rule-loader eval $(EVAL_RUN_OPTIONS) --all-models

## @inputs [CLI_ARGS="--selection selection.json --output reports"]
eval-report: check-uv ## Render offline eval report
	$(UV_RUN) ai-rules rule-loader report $(CLI_ARGS)

## @inputs REPORT=reports/eval-report-id
eval-report-verify: check-uv ## Verify an evidence report
	$(call require,REPORT,make eval-report-verify REPORT=reports/eval-report-id)
	$(UV_RUN) ai-rules rule-loader verify-report $(call shq,$(REPORT))

## @section Release | Maintainer only. Preview with DRY_RUN=1.
# Release recipes must never reference $(MAKE): make -n executes
# such lines, which would turn a dry run into a real release.
.PHONY: release-bump release-merge
## @inputs VERSION=X.Y.Z [DRY_RUN=1]
## @needs git, gh, signed commits
release-bump: ## Validate, bump, sign, and push release/vX.Y.Z
	$(call require,VERSION,make release-bump VERSION=X.Y.Z [DRY_RUN=1])
	UV=$(UV_Q) UV_PYTHON=$(PY_Q) DRY_RUN=$(call shq,$(DRY_RUN)) bash scripts/release.sh bump $(call shq,$(VERSION))

## @inputs VERSION=X.Y.Z [DRY_RUN=1]
## @needs git, gh
release-merge: ## Squash-merge in an isolated worktree, tag, push, draft release
	$(call require,VERSION,make release-merge VERSION=X.Y.Z [DRY_RUN=1])
	UV=$(UV_Q) UV_PYTHON=$(PY_Q) DRY_RUN=$(call shq,$(DRY_RUN)) bash scripts/release.sh merge $(call shq,$(VERSION))
