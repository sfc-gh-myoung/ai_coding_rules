#!/bin/bash
# Hook: UserPromptSubmit — run deterministic rule matcher and inject manifest as system-reminder
# Receives JSON {"prompt": "..."} on stdin, outputs <system-reminder> context on stdout.

set -euo pipefail

# Read prompt from stdin (Cortex Code sends JSON with "prompt" field)
INPUT_JSON=$(cat)
USER_PROMPT=$(echo "$INPUT_JSON" | jq -r '.prompt // empty' 2>/dev/null || echo "")
if [ -z "$USER_PROMPT" ]; then
    # Fallback: treat entire input as the prompt
    USER_PROMPT="$INPUT_JSON"
fi

# Diagnostics: every problem is printed to stderr and collected so it can also be
# shown in the injected context (some clients hide hook stderr). The hook always
# exits 0, so a broken install never blocks the user's prompt.
WARNINGS=()
warn() {
    WARNINGS+=("$1")
    echo "ai-rules hook: $1" >&2
}

# Emit only the warnings (nothing could be injected) and exit 0.
bail() {
    warn "$1"
    emit_warnings_only
    exit 0
}

emit_warnings_only() {
    echo "<system-reminder>"
    echo "## AI Coding Rules — Hook Warning"
    echo ""
    echo "Rule discovery could not inject rules for this request:"
    echo ""
    for w in "${WARNINGS[@]}"; do
        echo "- $w"
    done
    echo "</system-reminder>"
}

# Resolve this script through symlinks (BSD/bash 3.2 safe: no readlink -f).
SCRIPT="$0"
while [ -L "$SCRIPT" ]; do
    LINK_DIR=$(cd "$(dirname "$SCRIPT")" && pwd -P)
    SCRIPT=$(readlink "$SCRIPT")
    case "$SCRIPT" in
        /*) ;;
        *) SCRIPT="${LINK_DIR}/${SCRIPT}" ;;
    esac
done
SCRIPT_ROOT="$(cd "$(dirname "$SCRIPT")/.." && pwd -P)"

# Resolve plugin root and paths using BSD-safe physical directory resolution.
PLUGIN_ROOT="${CLAUDE_PLUGIN_ROOT:-$SCRIPT_ROOT}"
if [ ! -d "$PLUGIN_ROOT" ]; then
    warn "CLAUDE_PLUGIN_ROOT is not a directory (${PLUGIN_ROOT}); using ${SCRIPT_ROOT}"
    PLUGIN_ROOT="$SCRIPT_ROOT"
fi
RULES_DIR="${PLUGIN_ROOT}/rules"
MATCH_SCRIPT="${PLUGIN_ROOT}/skills/rule-loader/scripts/match_rules.py"

# The standalone script is stdlib-only — any python3 works (no venv needed)
if [ -x "${PLUGIN_ROOT}/.venv/bin/python" ]; then
    PYTHON="${PLUGIN_ROOT}/.venv/bin/python"
elif command -v python3 &>/dev/null; then
    PYTHON="python3"
elif command -v python &>/dev/null; then
    PYTHON="python"
else
    bail "python3 and python are not on PATH; install Python 3 to enable rule discovery"
fi

# Verify the standalone script and rules directory exist
if [ ! -f "$MATCH_SCRIPT" ]; then
    bail "rule matcher not found at ${MATCH_SCRIPT}; the install is incomplete"
fi
if [ ! -d "$RULES_DIR" ]; then
    bail "rules directory not found at ${RULES_DIR}; the install is incomplete"
fi

# Run the deterministic matcher
MANIFEST=$("$PYTHON" "$MATCH_SCRIPT" \
    --prompt "$USER_PROMPT" \
    --rules-dir "$RULES_DIR" \
    --max-entries 8 \
    --max-tokens 100000 \
    2>/dev/null) || MATCH_RC=$?

if [ "${MATCH_RC:-0}" -ne 0 ]; then
    bail "rule matcher failed (exit ${MATCH_RC}); run ${MATCH_SCRIPT} manually to see the error"
fi
if [ -z "$MANIFEST" ]; then
    bail "rule matcher produced no output"
fi

# Extract rule paths from manifest load_sequence (deduplicated). An empty list
# is a normal "nothing matched"; unparseable matcher output is a failure.
RULE_PATHS=$(printf '%s\n' "$MANIFEST" | "$PYTHON" -c "
import json, sys
data = json.load(sys.stdin)
seen = set()
out = []
for r in data.get('load_sequence', []):
    p = r.get('rule_path', '')
    if not p or p in seen:
        continue
    seen.add(p)
    out.append(p)
print('\n'.join(out))
" 2>/dev/null) || bail "rule matcher output could not be parsed"

if [ -z "$RULE_PATHS" ]; then
    exit 0
fi

# Resolve every logical rule path to one canonical absolute path in a single
# Python process. Escape markdown-significant path characters before rendering.
ABSOLUTE_PATHS=$(printf '%s\n' "$RULE_PATHS" | "$PYTHON" -c "
import os
import sys

root = sys.argv[1]

def markdown_escape(path):
    for ch in ('\\\\', '|', '*', '_', '[', ']', chr(96)):
        path = path.replace(ch, '\\\\' + ch)
    return path

out = []
for line in sys.stdin:
    rel = line.rstrip('\n')
    if rel:
        out.append(markdown_escape(os.path.realpath(os.path.join(root, rel))))
print('\n'.join(out))
" "${PLUGIN_ROOT}" 2>/dev/null) || bail "could not resolve matched rule paths"

if [ -z "$ABSOLUTE_PATHS" ]; then
    bail "could not resolve matched rule paths"
fi

# Inject micro-kernel + matched rules as system-reminder
MICRO_KERNEL_FILE="${PLUGIN_ROOT}/micro_kernel_content.md"
if [ ! -f "$MICRO_KERNEL_FILE" ]; then
    MICRO_KERNEL_FILE="${PLUGIN_ROOT}/src/ai_rules/plugin/micro_kernel_content.md"
fi
if [ ! -f "$MICRO_KERNEL_FILE" ]; then
    warn "foundation kernel micro_kernel_content.md not found; injecting matched rules without it"
fi

echo "<system-reminder>"
echo "## AI Coding Rules — Rule Discovery"
echo ""
if [ -f "$MICRO_KERNEL_FILE" ]; then
    cat "$MICRO_KERNEL_FILE"
    echo ""
fi
echo "## Matched Rules for This Request"
echo ""
echo "Ranked rule candidates for your request (most relevant first). These are"
echo "candidates, not a read-list: select the most relevant (up to 3 per the cap"
echo "above), then read those plus any of their required dependencies. Required"
echo "dependencies do not count against the 3-rule cap."
echo ""
printf '%s\n' "$ABSOLUTE_PATHS" | while IFS= read -r abs; do
    echo "- $abs"
done
echo ""
echo "Read only the candidates you select with the Read tool."
if [ "${#WARNINGS[@]}" -gt 0 ]; then
    echo ""
    echo "Hook warnings:"
    for w in "${WARNINGS[@]}"; do
        echo "- $w"
    done
fi
echo "</system-reminder>"
exit 0
