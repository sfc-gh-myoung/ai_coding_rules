#!/bin/bash
# Hook: UserPromptSubmit — run deterministic rule matcher and inject manifest as system-reminder
# Receives JSON {"prompt": "..."} on stdin, outputs <system-reminder> context on stdout.

set -euo pipefail

# Read prompt from stdin (Cortex Code sends JSON with "prompt" field)
INPUT_JSON=$(cat)
USER_PROMPT=$(echo "$INPUT_JSON" | jq -r '.prompt // empty' 2>/dev/null || echo "")
if [ -z "$USER_PROMPT" ]; then
    # Fallback: treat entire input as the prompt
    USER_PROMPT="$INPUT_JSON"
fi

# Resolve plugin root and paths using BSD-safe physical directory resolution.
PLUGIN_ROOT="${CLAUDE_PLUGIN_ROOT:-$(cd "$(dirname "$0")/.." && pwd -P)}"
RULES_DIR="${PLUGIN_ROOT}/rules"
MATCH_SCRIPT="${PLUGIN_ROOT}/skills/rule-loader/scripts/match_rules.py"

# The standalone script is stdlib-only — any python3 works (no venv needed)
if [ -x "${PLUGIN_ROOT}/.venv/bin/python" ]; then
    PYTHON="${PLUGIN_ROOT}/.venv/bin/python"
elif command -v python3 &>/dev/null; then
    PYTHON="python3"
elif command -v python &>/dev/null; then
    PYTHON="python"
else
    exit 0
fi

# Verify the standalone script exists
if [ ! -f "$MATCH_SCRIPT" ]; then
    exit 0
fi

# Run the deterministic matcher
MANIFEST=$("$PYTHON" "$MATCH_SCRIPT" \
    --prompt "$USER_PROMPT" \
    --rules-dir "$RULES_DIR" \
    --max-entries 8 \
    --max-tokens 100000 \
    2>/dev/null) || MANIFEST=""

if [ -z "$MANIFEST" ]; then
    exit 0
fi

# Extract rule paths from manifest load_sequence (deduplicated)
RULE_PATHS=$(printf '%s\n' "$MANIFEST" | "$PYTHON" -c "
import json, sys
data = json.load(sys.stdin)
seen = set()
out = []
for r in data.get('load_sequence', []):
    p = r.get('rule_path', '')
    if not p or p in seen:
        continue
    seen.add(p)
    out.append(p)
print('\n'.join(out))
" 2>/dev/null || echo "")

if [ -z "$RULE_PATHS" ]; then
    exit 0
fi

# Resolve every logical rule path to one canonical absolute path in a single
# Python process. Escape markdown-significant path characters before rendering.
ABSOLUTE_PATHS=$(printf '%s\n' "$RULE_PATHS" | "$PYTHON" -c "
import os
import sys

root = sys.argv[1]

def markdown_escape(path):
    for ch in ('\\\\', '|', '*', '_', '[', ']', chr(96)):
        path = path.replace(ch, '\\\\' + ch)
    return path

out = []
for line in sys.stdin:
    rel = line.rstrip('\n')
    if rel:
        out.append(markdown_escape(os.path.realpath(os.path.join(root, rel))))
print('\n'.join(out))
" "${PLUGIN_ROOT}" 2>/dev/null || echo "")

if [ -z "$ABSOLUTE_PATHS" ]; then
    exit 0
fi

# Inject micro-kernel + matched rules as system-reminder
MICRO_KERNEL_FILE="${PLUGIN_ROOT}/micro_kernel_content.md"
if [ ! -f "$MICRO_KERNEL_FILE" ]; then
    MICRO_KERNEL_FILE="${PLUGIN_ROOT}/src/ai_rules/plugin/micro_kernel_content.md"
fi

echo "<system-reminder>"
echo "## AI Coding Rules — Rule Discovery"
echo ""
if [ -f "$MICRO_KERNEL_FILE" ]; then
    cat "$MICRO_KERNEL_FILE"
    echo ""
fi
echo "## Matched Rules for This Request"
echo ""
echo "Ranked rule candidates for your request (most relevant first). These are"
echo "candidates, not a read-list: select the most relevant (up to 3 per the cap"
echo "above), then read those plus any of their required dependencies. Required"
echo "dependencies do not count against the 3-rule cap."
echo ""
printf '%s\n' "$ABSOLUTE_PATHS" | while IFS= read -r abs; do
    echo "- $abs"
done
echo ""
echo "Read only the candidates you select with the Read tool."
echo "</system-reminder>"
exit 0
