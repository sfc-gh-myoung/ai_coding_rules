{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rule-loader-semantic-v1.schema.json",
  "title": "Rule loader semantic result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "matcher_sha256", "scope_sha256", "decisions"],
  "properties": {
    "schema_version": {"const": "rule-loader-semantic/v1"},
    "matcher_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "scope_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rule_path", "selected", "evidence"],
        "properties": {
          "rule_path": {"type": "string", "pattern": "^rules/.+\\.md$"},
          "selected": {"type": "boolean"},
          "evidence": {"type": "string", "minLength": 1, "maxLength": 600}
        }
      }
    }
  }
}