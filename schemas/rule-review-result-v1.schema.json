{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rule-review-result/v1",
  "title": "Rule Review Result v1",
  "description": "Canonical JSON artifact for a single rule review. Markdown is generated deterministically from this artifact; never edit the Markdown directly.",
  "type": "object",
  "required": [
    "schema_version",
    "artifact_id",
    "rule_name",
    "review_mode",
    "producer",
    "review_date",
    "executive_summary",
    "dimensions",
    "findings",
    "score",
    "verdict",
    "blocking_issue_count",
    "hard_caps"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "rule-review-result/v1"
    },
    "artifact_id": {
      "type": "string",
      "minLength": 1,
      "description": "Stable identifier for this review artifact (e.g. UUID or slug)."
    },
    "rule_name": {
      "type": "string",
      "minLength": 1,
      "description": "Filename or path of the rule being reviewed."
    },
    "review_mode": {
      "enum": ["FULL", "FOCUSED", "STALENESS"]
    },
    "producer": {
      "$ref": "#/$defs/ProducerEvidence"
    },
    "review_date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "ISO 8601 date (YYYY-MM-DD)."
    },
    "executive_summary": {
      "type": "array",
      "items": { "$ref": "#/$defs/Claim" },
      "minItems": 1
    },
    "dimensions": {
      "type": "array",
      "items": { "$ref": "#/$defs/DimensionResult" },
      "minItems": 6,
      "maxItems": 6,
      "description": "Exactly six canonical dimensions."
    },
    "findings": {
      "type": "array",
      "items": { "$ref": "#/$defs/Finding" }
    },
    "score": {
      "oneOf": [
        { "type": "number", "minimum": 0, "maximum": 100 },
        { "type": "null" }
      ]
    },
    "verdict": {
      "enum": ["EXECUTABLE", "EXECUTABLE_WITH_REFINEMENTS", "NEEDS_REFINEMENT", "NOT_EXECUTABLE"]
    },
    "blocking_issue_count": {
      "type": "integer",
      "minimum": 0
    },
    "hard_caps": {
      "type": "array",
      "items": { "$ref": "#/$defs/HardCap" }
    },
    "timing": {
      "oneOf": [
        { "$ref": "#/$defs/TimingEvidence" },
        { "type": "null" }
      ]
    },
    "extensions": {
      "type": "object",
      "description": "Namespaced extension fields. Keys must use a namespace prefix (e.g. 'x-myns:field')."
    }
  },
  "$defs": {
    "Evidence": {
      "type": "object",
      "required": ["kind"],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": ["source", "docs", "inference"]
        },
        "locator": {
          "oneOf": [
            { "type": "string", "minLength": 1 },
            { "type": "null" }
          ]
        },
        "quote": {
          "oneOf": [
            { "type": "string", "minLength": 1 },
            { "type": "null" }
          ]
        }
      }
    },
    "Claim": {
      "type": "object",
      "required": ["text", "evidence"],
      "additionalProperties": false,
      "properties": {
        "text": { "type": "string", "minLength": 1 },
        "evidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/Evidence" }
        }
      }
    },
    "Finding": {
      "type": "object",
      "required": ["finding_id", "severity", "claim", "recommendation", "rationale", "affected_paths"],
      "additionalProperties": false,
      "properties": {
        "finding_id": { "type": "string", "minLength": 1 },
        "severity": {
          "enum": ["critical", "high", "medium", "low"]
        },
        "claim": { "$ref": "#/$defs/Claim" },
        "recommendation": { "type": "string", "minLength": 1 },
        "rationale": { "type": "string", "minLength": 1 },
        "affected_paths": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "DimensionResult": {
      "type": "object",
      "required": ["name", "raw_score", "weight", "points", "findings"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "enum": [
            "actionability",
            "rule_size",
            "parsability",
            "completeness",
            "consistency",
            "cross_agent_consistency"
          ]
        },
        "raw_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 10
        },
        "weight": { "type": "number", "exclusiveMinimum": 0 },
        "points": { "type": "number", "minimum": 0 },
        "findings": {
          "type": "array",
          "items": { "$ref": "#/$defs/Finding" }
        }
      }
    },
    "HardCap": {
      "type": "object",
      "required": ["condition", "effect"],
      "additionalProperties": false,
      "properties": {
        "condition": { "type": "string", "minLength": 1 },
        "effect": { "type": "string", "minLength": 1 },
        "description": { "type": "string" }
      }
    },
    "ProducerEvidence": {
      "type": "object",
      "required": ["model"],
      "additionalProperties": false,
      "properties": {
        "model": { "type": "string", "minLength": 1 },
        "session_id": {
          "oneOf": [
            { "type": "string" },
            { "type": "null" }
          ]
        },
        "agent_id": {
          "oneOf": [
            { "type": "string" },
            { "type": "null" }
          ]
        }
      }
    },
    "TimingEvidence": {
      "type": "object",
      "required": ["elapsed_seconds"],
      "additionalProperties": false,
      "properties": {
        "elapsed_seconds": { "type": "number", "exclusiveMinimum": 0 },
        "start_iso": {
          "oneOf": [
            { "type": "string" },
            { "type": "null" }
          ]
        },
        "end_iso": {
          "oneOf": [
            { "type": "string" },
            { "type": "null" }
          ]
        }
      }
    }
  }
}
