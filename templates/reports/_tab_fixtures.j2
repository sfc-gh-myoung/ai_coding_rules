  <!-- ========== TAB: TEST FIXTURES ========== -->
  <section class="tab-panel" id="fixtures" role="tabpanel" data-tab-title="Fixtures" x-show="tab==='fixtures'" x-cloak x-transition:enter.opacity.duration.200ms>
    <h2>Test Fixture Catalog</h2>

    <p>Each fixture is a synthetic user prompt designed to exercise specific rule-loading paths. This section documents the exact prompts, expected rule sets, and trigger mechanisms used in this evaluation. Fixtures are grouped by complexity tier.</p>

    <div class="callout callout-info">
      <strong>How to read each fixture:</strong>
      <ul style="margin:0.5rem 0 0 1rem; padding:0;">
        <li><strong>Prompt</strong>: The exact text sent to the model as the user message.</li>
        <li><strong>Required</strong>: Rules the model must read and cite for a passing result.</li>
        <li><strong>Forbidden</strong>: Rules that must NOT be loaded (tests over-eager matching).</li>
        <li><strong>Optional</strong>: Rules that may reasonably be loaded but are not required for a pass.</li>
        <li><strong>Triggers</strong>: The keywords, extensions, filenames, or directories that the deterministic matcher uses to surface this fixture&rsquo;s required rules.</li>
      </ul>
    </div>

    {% set tiers = {"simple": [], "medium": [], "complex": []} %}
    {% for fx in fixture_catalog %}
      {% if fx.variant in tiers %}
        {% set _ = tiers[fx.variant].append(fx) %}
      {% endif %}
    {% endfor %}

    <div x-data="{ subTab: 'fixtures-simple' }">
    {# Sub-tab navigation for fixture tiers #}
    <nav class="sub-tablist" aria-label="Fixture complexity tiers">
      {% if tiers["simple"] %}<a role="tab" :aria-selected="(subTab==='fixtures-simple').toString()" :tabindex="subTab==='fixtures-simple' ? 0 : -1" :class="{ active: subTab==='fixtures-simple' }" @click.prevent="subTab = 'fixtures-simple'">Simple ({{ tiers["simple"] | length }})</a>{% endif %}
      {% if tiers["medium"] %}<a role="tab" :aria-selected="(subTab==='fixtures-medium').toString()" :tabindex="subTab==='fixtures-medium' ? 0 : -1" :class="{ active: subTab==='fixtures-medium' }" @click.prevent="subTab = 'fixtures-medium'">Medium ({{ tiers["medium"] | length }})</a>{% endif %}
      {% if tiers["complex"] %}<a role="tab" :aria-selected="(subTab==='fixtures-complex').toString()" :tabindex="subTab==='fixtures-complex' ? 0 : -1" :class="{ active: subTab==='fixtures-complex' }" @click.prevent="subTab = 'fixtures-complex'">Complex ({{ tiers["complex"] | length }})</a>{% endif %}
    </nav>

    {% for tier_name, tier_label, tier_desc in [
      ("simple", "Simple Tier", "Single-domain prompts testing one or two rule triggers with low ambiguity."),
      ("medium", "Medium Tier", "Multi-domain prompts where the correct rule set is non-obvious."),
      ("complex", "Complex Tier", "Multi-step tasks spanning several domains with dependencies and forbidden exclusions.")
    ] %}
    {% set tier_fixtures = tiers[tier_name] %}
    {% if tier_fixtures %}
    <div class="sub-panel" id="fixtures-{{ tier_name }}" x-show="subTab==='fixtures-{{ tier_name }}'" x-cloak>
      <p style="font-size:0.85rem; color:var(--text-muted); margin-bottom:1rem;">{{ tier_desc }}</p>

      {% for fx in tier_fixtures %}
      <details style="margin-bottom:0.75rem; border:1px solid var(--border); border-radius:8px; overflow:hidden;">
        <summary style="cursor:pointer; padding:0.75rem 1rem; font-weight:600; font-size:0.9rem; background:light-dark(var(--sf-gray-50, #F8FAFC), #1E293B);">
          <code style="font-weight:700;">{{ fx.id }}</code>
          {% if fx.description %}<span style="font-weight:400; color:var(--text-muted); margin-left:0.75rem;">{{ fx.description }}</span>{% endif %}
        </summary>
        <div style="padding:1rem; font-size:0.875rem;">
          <h4 style="margin:0 0 0.5rem; font-size:0.8rem; text-transform:uppercase; letter-spacing:0.05em; color:var(--text-muted);">Prompt</h4>
          <pre style="white-space:pre-wrap; word-break:break-word; background:light-dark(var(--sf-gray-50, #F8FAFC), #0F172A); color:light-dark(#1E293B, #E2E8F0); border:1px solid var(--border); border-radius:6px; padding:0.75rem; font-size:0.82rem; line-height:1.5; margin:0 0 1rem;">{{ fx.prompt }}</pre>

          <div style="display:grid; grid-template-columns:1fr 1fr; gap:1rem;">
            <div>
              <h4 style="margin:0 0 0.4rem; font-size:0.8rem; text-transform:uppercase; letter-spacing:0.05em; color:var(--text-muted);">Required Rules</h4>
              <ul style="margin:0; padding-left:1.2rem; font-size:0.82rem; line-height:1.6;">
                {% for r in fx.required %}<li><code>{{ r }}</code></li>{% endfor %}
                {% if not fx.required %}<li style="color:var(--text-muted); font-style:italic;">None</li>{% endif %}
              </ul>
            </div>
            <div>
              <h4 style="margin:0 0 0.4rem; font-size:0.8rem; text-transform:uppercase; letter-spacing:0.05em; color:var(--text-muted);">Forbidden Rules</h4>
              <ul style="margin:0; padding-left:1.2rem; font-size:0.82rem; line-height:1.6;">
                {% for r in fx.forbidden %}<li><code>{{ r }}</code></li>{% endfor %}
                {% if not fx.forbidden %}<li style="color:var(--text-muted); font-style:italic;">None</li>{% endif %}
              </ul>
            </div>
          </div>

          {% if fx.optional %}
          <div style="margin-top:0.75rem;">
            <h4 style="margin:0 0 0.4rem; font-size:0.8rem; text-transform:uppercase; letter-spacing:0.05em; color:var(--text-muted);">Optional Rules</h4>
            <ul style="margin:0; padding-left:1.2rem; font-size:0.82rem; line-height:1.6;">
              {% for r in fx.optional %}<li><code>{{ r }}</code></li>{% endfor %}
            </ul>
          </div>
          {% endif %}

          {% if fx.triggers.kw or fx.triggers.ext or fx.triggers.file or fx.triggers.dir %}
          <div style="margin-top:0.75rem;">
            <h4 style="margin:0 0 0.4rem; font-size:0.8rem; text-transform:uppercase; letter-spacing:0.05em; color:var(--text-muted);">Trigger Evidence</h4>
            <div style="display:flex; flex-wrap:wrap; gap:0.4rem;">
              {% for kw in fx.triggers.kw %}<span style="background:light-dark(#DBEAFE,#1E3A5F); color:light-dark(#1E40AF,#93C5FD); padding:0.15rem 0.5rem; border-radius:4px; font-size:0.75rem; font-family:monospace;">kw:{{ kw }}</span>{% endfor %}
              {% for ext in fx.triggers.ext %}<span style="background:light-dark(#D1FAE5,#064E3B); color:light-dark(#065F46,#6EE7B7); padding:0.15rem 0.5rem; border-radius:4px; font-size:0.75rem; font-family:monospace;">ext:{{ ext }}</span>{% endfor %}
              {% for f in fx.triggers.file %}<span style="background:light-dark(#FEF3C7,#451A03); color:light-dark(#92400E,#FCD34D); padding:0.15rem 0.5rem; border-radius:4px; font-size:0.75rem; font-family:monospace;">file:{{ f }}</span>{% endfor %}
              {% for d in fx.triggers.dir %}<span style="background:light-dark(#F3E8FF,#3B0764); color:light-dark(#6B21A8,#C4B5FD); padding:0.15rem 0.5rem; border-radius:4px; font-size:0.75rem; font-family:monospace;">dir:{{ d }}</span>{% endfor %}
            </div>
          </div>
          {% endif %}
        </div>
      </details>
      {% endfor %}
    </div>
    {% endif %}
    {% endfor %}
    </div><!-- end x-data subTab -->

    {% if not fixture_catalog %}
    <div class="callout callout-warning">
      <strong>Fixture catalog not available.</strong>
      <p>The fixture source YAML files were not found during report generation. Ensure the <code>fixtures/rule_loader_eval/</code> directory is present.</p>
    </div>
    {% endif %}
  </section>
