<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="snowflake-source" content="cortex-agent-authored">
<title>Rule-loader evidence report</title>
<script type="application/json" id="report-data">{{ embedded | safe }}</script>
<script type="application/json" id="snowflake-report-metadata">{"intent":"Local rule-loader evidence comparison","sections":[{"id":"comparison","title":"Comparison"},{"id":"evidence","title":"Fixture evidence"},{"id":"about","title":"Methodology"}]}</script>
<style>
:root{color-scheme:light dark;--bg:light-dark(#f3f6f9,#0c1620);--paper:light-dark(#fff,#142330);--text:light-dark(#223745,#dfebf3);--line:light-dark(#dce5eb,#304554);--tint:light-dark(#e8f7fc,#173748);--blue:light-dark(#086e96,#75d5f6)}
*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--text);font:16px/1.6 Arial,Helvetica,sans-serif}header{border-top:5px solid #29b5e8;background:var(--paper);padding:32px}h1,h2,h3{line-height:1.25}a{color:var(--blue)}a:focus-visible,button:focus-visible,input:focus-visible,select:focus-visible{outline:3px solid #29b5e8}.shell{max-width:1440px;margin:auto;padding:24px;display:grid;grid-template-columns:200px minmax(0,1fr);gap:28px}aside{position:sticky;top:20px;align-self:start}nav a{display:block;padding:8px;border-left:3px solid var(--line);text-decoration:none}nav a[aria-current]{background:var(--tint);border-color:#29b5e8}main{min-width:0}section{background:var(--paper);border:1px solid var(--line);padding:24px;margin-bottom:24px;border-radius:10px}.table-wrap{overflow-x:auto}table{border-collapse:collapse;width:100%;font-size:13px}caption{text-align:left;font-weight:bold;padding:8px}th,td{padding:9px;border-bottom:1px solid var(--line);text-align:left;overflow-wrap:break-word;word-break:normal;vertical-align:top}th{background:var(--tint)}code{font-family:ui-monospace,monospace;background:var(--tint);padding:1px 3px}td code span{white-space:nowrap}button,select{font:inherit;color:inherit;background:var(--paper);border:1px solid var(--line);padding:5px}.controls{display:flex;flex-wrap:wrap;gap:12px;margin:16px 0}.pickers{display:flex;flex-wrap:wrap;gap:12px}.note{border-left:4px solid #29b5e8;padding:12px;background:var(--tint)}.best{box-shadow:inset 0 -3px #15803d}.worst{box-shadow:inset 0 -3px #b45309}.chart-row{display:grid;grid-template-columns:minmax(140px,1fr) 2fr 80px;gap:10px;padding:3px}.bar{height:16px;background:#29b5e8;align-self:center}.chart{margin-bottom:20px}details{margin:10px 0}summary{cursor:pointer}pre{white-space:pre-wrap;overflow-wrap:break-word}dialog{max-width:min(900px,95vw);max-height:90vh;overflow:auto;background:var(--paper);color:var(--text);border:1px solid var(--line)}.print-only{display:none}.skip{position:absolute;top:-100px}.skip:focus{top:0}
@media(max-width:900px){.shell{grid-template-columns:minmax(0,1fr);padding:12px}aside{position:static}nav{display:flex;flex-wrap:wrap}section{padding:16px}}
@media print{@page{size:A4;margin:16mm}@page wide{size:A4 landscape;margin:12mm}:root{color-scheme:light}body{background:white;font-size:10pt}header{padding:0}.shell{display:block;padding:0}aside,.controls,.pickers,.screen-only,dialog{display:none!important}section{padding:0;border:0}.table-wrap{overflow:visible;page:wide}table{font-size:8pt}th,td{padding:5px}tr{break-inside:avoid}h2,h3,caption{break-after:avoid}.print-only{display:block}.chart{display:none}}
</style>
</head>
<body><a class="skip" href="#main">Skip to report</a>
<header><p>Snowflake / Local development evaluation</p><h1>Rule-loader evidence report</h1><p>{{ payload.mode | capitalize }} · {{ payload.configurations | length }} configurations · {{ payload.totals.observed }} observed / {{ payload.totals.planned }} planned samples</p></header>
<div class="shell"><aside><nav aria-label="Report sections"><a href="#comparison">Comparison</a><a href="#evidence">Fixture evidence</a><a href="#about">Methodology and sources</a></nav></aside><main id="main">
<section id="comparison"><h2>Configuration comparison</h2><p class="note">{% if payload.mode == 'inspection' %}Inspection only: latest-run evidence is not an explicit comparison cohort. Rankings and extrema are disabled.{% else %}Explicit cohort. Headline protocol success includes skipped reads and infrastructure outcomes as non-passes. Scored rate is a separate diagnostic.{% endif %}</p>
<div class="controls"><label>Model <select id="model-filter"><option value="">All models</option>{% for row in payload.configurations %}<option>{{ row.model }}</option>{% endfor %}</select></label><label><input type="checkbox" id="select-all" checked> Select all configurations</label></div><div class="pickers" id="configuration-pickers"></div>
<p id="selection-status" aria-live="polite"></p><div class="table-wrap"><table id="summary-table"><caption>Fixed-cohort descriptive estimates. Click column headings to sort.</caption><thead></thead><tbody></tbody></table></div><p>Best/Worst underline qualified displayed extrema, including ties—not statistical superiority. Missing and partial measurements do not compete.</p><div id="charts"></div></section>
<section id="evidence"><h2>Fixture and run evidence</h2><p>Fixture links open observed executions. Missing planned slots are counts, not invented attempts.</p><div class="table-wrap"><table id="fixture-table"><thead><tr><th>Configuration</th><th>Fixture</th><th>Passes / observed</th><th>Planned</th><th>Evidence</th></tr></thead><tbody></tbody></table></div><div class="print-only" id="print-evidence"></div></section>
<section id="about"><h2>Methodology and sources</h2><dl><dt>pass@1</dt><dd>Equal-fixture mean of successful-attempt fractions across all observed outcomes.</dd><dt>pass@3</dt><dd>Mean probability of at least one success in a random three-attempt subset without replacement. Fixtures need at least three observed attempts.</dd><dt>pass^3</dt><dd>Mean probability all three sampled attempts succeed; same eligible cohort.</dd><dt>Scored rate</dt><dd>Equal-fixture scored success diagnostic; errors and model-skipped-reads are excluded, matching evaluator outcome semantics.</dd><dt>AI Credits</dt><dd>Mean selected-attempt estimate using embedded rates. Inclusive input counts subtract cache write/read before applying uncached input rates. Not metered spend.</dd><dt>Capture labels</dt><dd>Every value shows captured / expected counts. Missing data is unavailable, not zero. Partial quality cohorts or capture do not enter comparative extrema.</dd></dl>
<ul>{% for limit in payload.limitations %}<li>{{ limit }}</li>{% endfor %}</ul><h3>Exclusions</h3><ul>{% for model, reason in payload.exclusions.items() %}<li>{{ model }}: {{ reason }}</li>{% else %}<li>None</li>{% endfor %}</ul><h3>Archived attempts</h3><ul>{% for archive in payload.archives %}<li>{{ archive.model }}: {{ archive.observed }} observed samples; {{ archive.cost_capture }}</li>{% else %}<li>None</li>{% endfor %}</ul><details><summary>Protocol, pricing snapshot, source identities and digests</summary><pre>{{ payload.selection | tojson(indent=2) }}</pre></details></section>
</main></div><dialog id="execution-dialog"><button id="close-dialog">Close evidence</button><h2 id="dialog-title"></h2><div id="dialog-content"></div></dialog>
<script>
'use strict';
const payload=JSON.parse(document.getElementById('report-data').textContent);
const rows=payload.configurations;
const selected=new Set(rows.map(row=>row.id));
const columns=[['model','Configuration'],['observed','Attempts'],['pass_at_1','pass@1'],['pass_at_3','pass@3'],['pass_all_3','pass^3'],['scored_rate','Scored rate'],['credits','Mean AI Credits'],['duration_ms','Mean seconds'],['output_tokens','Mean output tokens'],['turns','Mean turns']];
let sortKey='pass_at_1',descending=true;
const table=document.getElementById('summary-table');
function identifier(value){const code=document.createElement('code');for(const part of value.match(/[^._/\-,:=]+[._/\-,:=]?|[._/\-,:=]/g)||[value]){const span=document.createElement('span');span.textContent=part;code.append(span,document.createElement('wbr'));}return code;}
function value(row,key){return key==='model'?row.model:key==='observed'?row.observed:row.metrics[key].value;}
function format(number,key){if(number===null)return 'Unavailable';if(key.startsWith('pass_')||key==='scored_rate')return (number*100).toFixed(2)+'%';if(key==='duration_ms')return (number/1000).toFixed(2);return number.toLocaleString(undefined,{maximumFractionDigits:key==='credits'?4:2});}
function visible(){const model=document.getElementById('model-filter').value;return rows.filter(row=>selected.has(row.id)&&(!model||row.model===model));}
function ordered(items){return [...items].sort((left,right)=>{const a=value(left,sortKey),b=value(right,sortKey);if(a===null)return b===null?0:1;if(b===null)return -1;return (typeof a==='string'?a.localeCompare(b):a-b)*(descending?-1:1);});}
function evidence(row,fixture){document.getElementById('dialog-title').textContent=row.model+' / '+fixture;const content=document.getElementById('dialog-content');content.replaceChildren();for(const sample of row.executions.filter(item=>item.fixture_id===fixture).sort((a,b)=>a.run_number-b.run_number)){const details=document.createElement('details');details.open=true;const summary=document.createElement('summary');summary.textContent='Run '+sample.run_number+': '+sample.result;const pre=document.createElement('pre');pre.textContent=JSON.stringify(sample,null,2);details.append(summary,pre);content.append(details);}document.getElementById('execution-dialog').showModal();}
for(const row of rows){const label=document.createElement('label'),input=document.createElement('input');input.type='checkbox';input.checked=true;input.dataset.configuration=row.id;input.addEventListener('change',()=>{input.checked?selected.add(row.id):selected.delete(row.id);render();});label.append(input,document.createTextNode(row.id));document.getElementById('configuration-pickers').append(label);}
function render(){const items=visible(),head=document.createElement('tr');for(const [key,label] of columns){const th=document.createElement('th');th.scope='col';if(key===sortKey)th.setAttribute('aria-sort',descending?'descending':'ascending');const button=document.createElement('button');button.textContent=label;button.addEventListener('click',()=>{descending=sortKey===key?!descending:key.startsWith('pass_')||key==='scored_rate';sortKey=key;render();});th.append(button);head.append(th);}table.tHead.replaceChildren(head);table.tBodies[0].replaceChildren();
for(const row of ordered(items)){const tr=document.createElement('tr');for(const [key] of columns){const td=document.createElement('td'),current=value(row,key);if(key==='model')td.append(identifier(row.id));else{td.textContent=format(current,key);if(row.metrics[key]){const metric=row.metrics[key];const small=document.createElement('div');small.textContent=metric.status+' · '+metric.captured+'/'+metric.expected;td.append(small);const eligible=items.filter(item=>item.eligible&&item.metrics[key].status==='complete'&&value(item,key)!==null);const numbers=eligible.map(item=>value(item,key));if(row.eligible&&metric.status==='complete'&&numbers.length>1&&Math.min(...numbers)!==Math.max(...numbers)){const higher=key.startsWith('pass_')||key==='scored_rate';if(current===(higher?Math.max(...numbers):Math.min(...numbers)))td.className='best';if(current===(higher?Math.min(...numbers):Math.max(...numbers)))td.className='worst';}}}tr.append(td);}table.tBodies[0].append(tr);}
const charts=document.getElementById('charts');charts.replaceChildren();for(const [key,label] of columns.slice(2)){const box=document.createElement('div');box.className='chart';box.setAttribute('role','img');box.setAttribute('aria-label',label+' companion chart');const heading=document.createElement('h3');heading.textContent=label;box.append(heading);const numeric=items.filter(row=>value(row,key)!==null).sort((a,b)=>value(b,key)-value(a,key));const maximum=Math.max(0,...numeric.map(row=>value(row,key)));for(const row of numeric){const line=document.createElement('div');line.className='chart-row';const name=document.createElement('span');name.textContent=row.model;const track=document.createElement('div'),bar=document.createElement('div');bar.className='bar';bar.style.width=(maximum?value(row,key)/maximum*100:0)+'%';track.append(bar);const reading=document.createElement('span');reading.textContent=format(value(row,key),key);line.append(name,track,reading);box.append(line);}if(!numeric.length)box.append(document.createTextNode('No measurements for this selection.'));charts.append(box);}
const body=document.querySelector('#fixture-table tbody');body.replaceChildren();for(const row of ordered(items))for(const fixture of row.fixtures){const tr=document.createElement('tr');for(const text of [row.id,fixture.fixture,fixture.passed+'/'+fixture.observed,String(fixture.planned)]){const td=document.createElement('td');td.textContent=text;tr.append(td);}const td=document.createElement('td'),button=document.createElement('button');button.textContent='Observed runs';button.addEventListener('click',()=>evidence(row,fixture.fixture));td.append(button);tr.append(td);body.append(tr);}
const all=document.getElementById('select-all');all.checked=selected.size===rows.length;all.indeterminate=selected.size>0&&selected.size<rows.length;document.getElementById('selection-status').textContent=items.length+' visible configurations; estimates and cohorts remain fixed.';}
document.getElementById('select-all').addEventListener('change',event=>{selected.clear();if(event.target.checked)for(const row of rows)selected.add(row.id);for(const input of document.querySelectorAll('[data-configuration]'))input.checked=selected.has(input.dataset.configuration);render();});
document.getElementById('model-filter').addEventListener('change',render);document.getElementById('close-dialog').addEventListener('click',()=>document.getElementById('execution-dialog').close());
let beforePrint=null;window.addEventListener('beforeprint',()=>{beforePrint={selected:[...selected],model:document.getElementById('model-filter').value,scroll:window.scrollY};selected.clear();for(const row of rows)selected.add(row.id);document.getElementById('model-filter').value='';render();const appendix=document.getElementById('print-evidence');appendix.replaceChildren();for(const row of rows)for(const sample of row.executions){const details=document.createElement('details');details.open=true;const summary=document.createElement('summary');summary.textContent=row.model+' / '+sample.fixture_id+' / run '+sample.run_number+': '+sample.result;const pre=document.createElement('pre');pre.textContent=JSON.stringify(sample,null,2);details.append(summary,pre);appendix.append(details);}});
window.addEventListener('afterprint',()=>{if(!beforePrint)return;selected.clear();for(const id of beforePrint.selected)selected.add(id);document.getElementById('model-filter').value=beforePrint.model;document.getElementById('print-evidence').replaceChildren();render();window.scrollTo(0,beforePrint.scroll);beforePrint=null;});
const links=[...document.querySelectorAll('nav a')];function active(){let current=links[0];for(const link of links)if(document.querySelector(link.hash).getBoundingClientRect().top<window.innerHeight*0.35)current=link;if(window.scrollY+window.innerHeight>=document.documentElement.scrollHeight-2)current=links.at(-1);for(const link of links)link===current?link.setAttribute('aria-current','location'):link.removeAttribute('aria-current');}window.addEventListener('scroll',active,{passive:true});render();active();
</script></body></html>
